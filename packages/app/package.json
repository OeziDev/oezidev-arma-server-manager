{
  "name": "oezi-arma-manager-app",
  "productName": "OeziDev Arma Server Manager",
  "version": "1.0.0",
  "description": "Arma 3 dedicated server manager by OeziDev",
  "author": "OeziDev",
  "main": "dist/main/main.cjs",
  "private": true,
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build --config vite.config.mts",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/saira-stencil-one": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4",
    "@oezi/arma-core": "^1.0.0"
  }
}
