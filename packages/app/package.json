{
  "name": "oezi-arma-manager-app",
  "productName": "OeziDev Arma Server Manager",
  "version": "1.2.3",
  "description": "Arma 3 dedicated server manager by OeziDev",
  "author": "OeziDev",
  "main": "dist/main/main.cjs",
  "private": true,
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build --config vite.config.mts",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "release:win": "npm run build && electron-builder --win --x64 --publish always"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/saira-stencil-one": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4",
    "@oezi/arma-core": "^1.2.3"
  },
  "build": {
    "appId": "dev.oezi.armamanager",
    "productName": "OeziDev Arma Server Manager",
    "copyright": "Copyright © 2026 OeziDev",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/tray.png",
        "to": "tray.png"
      },
      {
        "from": "build/tray@2x.png",
        "to": "tray@2x.png"
      },
      {
        "from": "build/licenses",
        "to": "licenses"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "OeziArmaManager"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Arma Server Manager",
      "artifactName": "OeziDev-Arma-Server-Manager-Setup-${version}.${ext}",
      "installerLanguages": [
        "tr_TR",
        "en_US"
      ],
      "multiLanguageInstaller": true,
      "uninstallDisplayName": "OeziDev Arma Server Manager"
    },
    "portable": {
      "artifactName": "OeziDev-Arma-Server-Manager-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "executableName": "oezi-arma-manager",
      "artifactName": "OeziDev-Arma-Server-Manager-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "OeziDev",
        "repo": "oezidev-arma-server-manager",
        "releaseType": "release"
      }
    ]
  },
  "license": "UNLICENSED"
}
